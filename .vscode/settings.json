{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.idea": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "android/.gradle": true,
    "android/.idea": true,
    "android/.kotlin": true,
    "android/build": true,
    "android/app/build": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/build": true,
    "android/.gradle": true,
    "android/.idea": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    ".",
    "-p",
    "*test.py"
  ],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true
}
