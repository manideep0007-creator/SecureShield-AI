<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9080C14"
    android:padding="20dp">

    <!-- Centered Cyber Alert HUD Modal -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/bg_dark_card"
        app:strokeColor="@color/threat_critical"
        app:strokeWidth="1.5dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HUD Top Intercept Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_badge_threat"
                    android:text="🛡️ RADAR • ACTIVE INTERCEPT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.02s LATENCY"
                    android:textSize="10sp"
                    android:textColor="@color/threat_safe"
                    android:fontFamily="monospace"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Headline -->
            <TextView
                android:id="@+id/text_hud_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="High-Risk Link Blocked"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/text_hud_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Universal Link Guard intercepted a phishing vector before navigation was triggered."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <!-- Intercepted Target URI Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_code_preview"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTERCEPTED URI HOOK"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/threat_warning"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/text_hud_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="http://192.168.1.1@secure-login-verify.xyz/account"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />

                <!-- Threat Tags -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_threat"
                        android:text="Credential Harvester"
                        android:textSize="9sp"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_warning"
                        android:text="Host Spoofing"
                        android:textSize="9sp"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Threat Verdict Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_dark_card_elevated"
                app:strokeColor="@color/bg_dark_card_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/text_hud_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="88"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/threat_critical"
                        android:fontFamily="monospace"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CRITICAL THREAT"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/threat_critical" />

                        <TextView
                            android:id="@+id/text_hud_classification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phishing &amp; Credential Theft"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dual Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hud_keep_safe"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🛡️ Keep Me Safe (Block &amp; Return)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                app:backgroundTint="@color/threat_critical"
                app:cornerRadius="25dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hud_ignore"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Ignore &amp; Proceed Anyway (Unsafe)"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
