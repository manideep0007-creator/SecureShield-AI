<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SecureShield AI"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_scan_gmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Gmail &amp; Scan Inbox"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#D32F2F" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_background_protection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background Protection"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/text_background_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Protection inactive"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_universal_guard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardian Mode (On-Screen Protection)"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/text_universal_guard_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitors visible text in real-time across apps (WhatsApp, Instagram, Browsers) for threats"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/text_universal_guard_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Accessibility service: Inactive"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_accessibility_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accessibility Settings"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_scan_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan History"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_server_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Server Settings"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Risk Verdict Card with Feedback Controls -->
        <LinearLayout
            android:id="@+id/layout_verdict_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E0E0E0"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/badge_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Awaiting Scan"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Feedback Controls next to Verdict -->
                <LinearLayout
                    android:id="@+id/layout_feedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_thumb_up"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👍"
                        android:textSize="16sp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_thumb_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👎"
                        android:textSize="16sp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_feedback_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Already submitted"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="#555555"
                android:visibility="gone"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target: N/A"
            android:textSize="14sp"
            android:textStyle="italic"
            android:layout_marginBottom="16dp" />

        <!-- Score Info -->
        <TextView
            android:id="@+id/text_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Risk Score: -- / 100"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Reasons -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Evidence Triggered:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/text_reasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="None"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Recommended Action -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommended Action:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/text_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textSize="16sp"
            android:textColor="#D32F2F"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
