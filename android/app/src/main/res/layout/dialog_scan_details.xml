<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Top Forensic Header with Severity Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forensic Threat Analysis"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multi-Engine Intelligence Audit"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/dialog_badge_classification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_threat"
                android:text="CRITICAL THREAT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Aggregate Threat Metric Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_dark_card"
            app:strokeColor="@color/bg_dark_card_stroke"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AGGREGATE THREAT METRIC"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/dialog_text_risk_score"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Risk Score: 88 / 100"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/dialog_text_confidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confidence: 94%"
                        android:textColor="@color/cyber_cyan"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Monospaced Intercepted Target Container -->
                <TextView
                    android:id="@+id/dialog_text_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Target: https://..."
                    android:textColor="@color/cyber_cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_code_preview"
                    android:padding="10dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recommended Action Callout Card (Amber/Red Tactical Border) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_dark_card_elevated"
            app:strokeColor="@color/threat_warning"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ IMMEDIATE ACTION REQUIRED"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/threat_warning"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/dialog_text_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Do not click or enter credentials. Threat payload quarantined."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7-Engine Diagnostic Matrix / Evidence Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="@color/bg_dark_card"
            app:strokeColor="@color/bg_dark_card_stroke"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7-ENGINE DIAGNOSTIC MATRIX"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <!-- Dynamic Engines List Container -->
                <LinearLayout
                    android:id="@+id/dialog_container_engines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Narrative Evidence / Reason Bullets -->
                <TextView
                    android:id="@+id/dialog_text_reasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Suspicious domain pattern\n• Obfuscated IP host routing"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Action / Close Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_btn_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Dismiss &amp; Keep Device Secure"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/bg_dark"
            app:backgroundTint="@color/cyber_cyan"
            app:cornerRadius="24dp" />

    </LinearLayout>
</ScrollView>
